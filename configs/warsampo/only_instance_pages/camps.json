{
    "id": "camps",
    "endpoint": {
        "url": "https://ldf.fi/warsampo-qlever/sparql",
        "useAuth": false,
        "prefixesFile": "SparqlQueriesPrefixes.js"
    },
    "sparqlQueriesFile": "SparqlQueriesCamps.js",
    "baseURI": "http://ldf.fi/warsa",
    "URITemplate": "<BASE_URI>/prisoners/<LOCAL_ID>",
    "enableDynamicLanguageChange": true,
    "maps": {
        "campLocation": {
            "center": [
                65.184809,
                27.314050
            ],
            "zoom": 4
        }
    },
    "resultClasses": {
        "camps": {
            "instanceConfig": {
                "propertiesQueryBlock": "campPropertiesInstancePage",
                "instancePageResultClasses": {
                    "instancePageTable": {
                        "tabID": 0,
                        "component": "InstancePageTable",
                        "tabPath": "table",
                        "tabIcon": "CalendarViewDay"
                    },
                    "campLocation": {
                        "tabID": 1,
                        "pageType": "instancePage",
                        "component": "LeafletMap",
                        "tabPath": "map",
                        "tabIcon": "AddLocation",
                        "sparqlQuery": "campMapQuery",
                        "facetClass": "camps",
                        "filterTarget": "id",
                        "resultMapper": "mapInstancePagePlaces",
                        "instanceConfig": {
                            "createPopUpContent": "createConfigurablePopUpContent",
                            "popUpElements": [
                                { 
                                    "htmlElement": "h3",
                                    "arrayParentElement": null,
                                    "type": "object",
                                    "source": "sparql",
                                    "variableName": "prefLabel",
                                    "isArray": false,
                                    "makeLink": false,
                                    "externalLink": false
                                }
                            ]
                        },
                        "showExternalLayers": false,
                        "showInstanceCountInClusters": false
                    }
                }
            }  
        }
    },
    "properties": [
        {
            "id": "prefLabel",
            "valueType": "object",
            "makeLink": true,
            "externalLink": false,
            "sortValues": true,
            "numberedList": false,
            "minWidth": 150
        },
        {
            "id": "campId",
            "valueType": "string",
            "makeLink": false,
            "externalLink": false,
            "sortValues": true,
            "numberedList": false,
            "onlyOnInstancePage": true,
            "expandedOnInstancePage": true
        },
        {
            "id": "location",
            "valueType": "string",
            "makeLink": false,
            "externalLink": false,
            "sortValues": true,
            "numberedList": false,
            "onlyOnInstancePage": true,
            "expandedOnInstancePage": true
        },
        {
            "id": "timeOfOperation",
            "valueType": "string",
            "makeLink": false,
            "externalLink": false,
            "sortValues": true,
            "numberedList": false,
            "onlyOnInstancePage": true,
            "expandedOnInstancePage": true
        },
        {
            "id": "campInformation",
            "valueType": "string",
            "makeLink": false,
            "externalLink": false,
            "sortValues": true,
            "numberedList": false,
            "onlyOnInstancePage": true,
            "expandedOnInstancePage": true
        },
        {
            "id": "lat",
            "valueType": "string",
            "makeLink": false,
            "externalLink": false,
            "sortValues": true,
            "numberedList": false,
            "onlyOnInstancePage": true
        },
        {
            "id": "long",
            "valueType": "string",
            "makeLink": false,
            "externalLink": false,
            "sortValues": true,
            "numberedList": false,
            "onlyOnInstancePage": true
        },
        {
            "id": "uri",
            "valueType": "object",
            "makeLink": true,
            "externalLink": true,
            "sortValues": true,
            "numberedList": false,
            "onlyOnInstancePage": true
        }
    ]
}