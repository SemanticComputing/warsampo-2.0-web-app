{
    "id": "actors",
    "endpoint": {
        "url": "https://ldf.fi/warsampo-qlever/sparql",
        "useAuth": false,
        "prefixesFile": "SparqlQueriesPrefixes.js"
    },
    "sparqlQueriesFile": "SparqlQueriesActors.js",
    "baseURI": "http://ldf.fi/warsa",
    "URITemplate": "<BASE_URI>/actors/<LOCAL_ID>",
    "enableDynamicLanguageChange": true,
    "resultClasses": {
        "actors": {
            "instanceConfig": {
                "propertiesQueryBlock": "actorPropertiesInstancePageAlt",
                "instancePageResultClasses": {
                    "overviewPage": {
                        "tabID": 0,
                        "tabPath": "table",
                        "tabIcon": "CalendarViewDay",
                        "component": "CustomComponent",
                        "componentName": "PersonPage",
                        "sparqlQuery": "personPropertiesInstancePage",
                        "facetClass": "casualties",
                        "filterTarget": "id",
                        "resultMapper": "makeObjectList",
                        "pageType": "instancePage",
                        "componentConfig": {
                            "groups": [
                                {
                                    "id": "personal_info",
                                    "properties": [ "prefLabel", "rank", "unit", "municipalityOfDomicile", "occupation", "maritalStatus", "citizenship", "nationality", "motherTongue", "municipalityOfResidence", "unitCode", "numberOfChildren", "municipalityOfBirth", "dateOfBirth", "deathTime", "uri" ],
                                    "requiredProperties": [ "uri" ],
                                    "requiredAny": false
                                },
                                {
                                    "id": "wounding",
                                    "properties": [ "placeOfWounding", "dateOfWounding" ],
                                    "requiredProperties": [ "placeOfWounding", "dateOfWounding" ],
                                    "requiredAny": true
                                },
                                {
                                    "id": "disappearance",
                                    "properties": [ "municipalityOfGoingMIA", "placeOfGoingMIA", "dateOfGoingMIA", "disappearingEvent" ],
                                    "requiredProperties": [ "disappearingEvent" ],
                                    "requiredAny": false
                                },
                                {
                                    "id": "prisoner",
                                    "properties": [ "municipalityOfCapture", "dateOfCapture", "descriptionOfCapture", "otherCaptivityInformation", "captivity", "sotilaanAani", "prisonerRecord" ],
                                    "requiredProperties": [ "prisonerRecord" ],
                                    "requiredAny": false
                                },
                                {
                                    "id": "return",
                                    "properties": [ "dateOfReturn" ],
                                    "requiredProperties": [ "dateOfReturn" ],
                                    "requiredAny": false
                                },
                                {
                                    "id": "death",
                                    "properties": [ "deathTime", "municipalityOfDeath", "perishingCategory", "buriedIn", "municipalityOfBurial", "placeOfBurialNumber", "deathRecord" ],
                                    "requiredProperties": [ "deathRecord" ],
                                    "requiredAny": false
                                },
                                {
                                    "id": "other_sources",
                                    "properties": [ "article", "warsaPage", "externalPage" ],
                                    "requiredProperties": [ "article", "warsaPage", "externalPage" ],
                                    "requiredAny": true
                                }
                            ]
                        }
                    }
                }
            }  
        }
    },
