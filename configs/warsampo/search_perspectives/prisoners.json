        "captivityLocationsMap": {
            "tabID": 2,
            "component": "LeafletMap",
            "tabPath": "map",
            "tabIcon": "AddLocation",
            "sparqlQuery": "captivityPlacesQuery",
            "facetClass": "prisoners",
            "filterTarget": "record",
            "resultMapper": "mapPlaces",
            "showExternalLayers": true,
            "instanceConfig": {
                "propertiesQueryBlock": "placePropertiesInfoWindow",
                "relatedInstances": "captivitiesAt",
                "filterTarget": "related__id",
                "createPopUpContent": "createConfigurablePopUpContent",
                "popUpElements": [
                    { 
                        "htmlElement": "h3",
                        "arrayParentElement": null,
                        "type": "object",
                        "source": "sparql",
                        "variableName": "prefLabel",
                        "isArray": false,
                        "orderBy": null,
                        "makeLink": false,
                        "externalLink": false
                    },
                    { 
                        "htmlElement": "p",
                        "arrayParentElement": null,
                        "type": "string",
                        "source": "intl",
                        "variableName": "leafletMap.resultClasses.captivityLocationsMap.captivitiesAt",
                        "isArray": false,
                        "orderBy": null,
                        "makeLink": false,
                        "externalLink": false
                    },
                    { 
                        "htmlElement": "li",
                        "arrayParentElement": "ul",
                        "type": "object",
                        "source": "sparql",
                        "variableName": "related",
                        "isArray": true,
                        "orderBy": "prefLabel",
                        "includeUndefined": true,
                        "makeLink": true,
                        "externalLink": false
                    }
                ]
            }
        },
        "captivityMigrations": {
            "tabID": 3,
            "component": "Deck",
            "tabPath": "migrations",
            "tabIcon": "Redo",
            "sparqlQuery": "migrationsQuery",
            "facetClass": "prisoners",
            "filterTarget": "record",
            "resultMapper": "makeObjectList",
            "layerType": "arcLayer",
            "arcWidthVariable": "instanceCountScaled",
            "instanceVariable": "record",
            "showTooltips": true,
            "postprocess": {
                "func": "linearScale",
                "config": {
                    "variable": "instanceCount",
                    "minAllowed": 1,
                    "maxAllowed": 30
                }
            }
        },
        "captivityMigrationsDialog": {
            "sparqlQuery": "migrationsDialogQuery",
            "filterTarget": "id",
            "resultMapper": "makeObjectList"
        }
    },
