{
    "id": "prisoners",
    "endpoint": {
        "url": "https://ldf.fi/warsampo-qlever/sparql",
        "useAuth": false,
        "prefixesFile": "SparqlQueriesPrefixes.js"
    },
    "sparqlQueriesFile": "SparqlQueriesPrisoners.js",
    "baseURI": "http://ldf.fi/warsa",
    "URITemplate": "<BASE_URI>/prisoners/<LOCAL_ID>",
    "facetClass": "warsa:PrisonerRecord",
    "frontPageImage": "main_page/cemeteries.jpg",
    "searchMode": "faceted-search",
    "enableDynamicLanguageChange": true,
    "defaultActiveFacets": [
        "prefLabel"
    ],
    "defaultTab": "table",
    "defaultInstancePageTab": "table",
    "maps": {
    },
    "resultClasses": {
        "prisoners": {
            "paginatedResultsConfig": {
                "tabID": 0,
                "component": "ResultTable",
                "tabPath": "table",
                "tabIcon": "CalendarViewDay",
                "propertiesQueryBlock": "prisonerProperties",
                "paginatedResultsAlwaysExpandRows": false,
                "paginatedResultsRowContentMaxHeight": 190,
                "pagesize": 10,
                "sortBy": null,
                "sortDirection": null
            },
            "instanceConfig": {
                "propertiesQueryBlock": "prisonerPropertiesInstancePage",
                "instancePageResultClasses": {
                    "instancePageTable": {
                        "tabID": 0,
                        "component": "InstancePageTable",
                        "tabPath": "table",
                        "tabIcon": "CalendarViewDay"
                    }
                }
            }
        }
    },
    "properties": [
        {
            "id": "prefLabel",
            "valueType": "object",
            "makeLink": true,
            "externalLink": false,
            "sortValues": true,
            "numberedList": false,
            "minWidth": 200
        },
        {
            "id": "rank",
            "valueType": "object",
            "makeLink": false,
            "externalLink": false,
            "sortValues": true,
            "numberedList": false
        },
        {
            "id": "unit",
            "valueType": "object",
            "makeLink": false,
            "externalLink": false,
            "sortValues": true,
            "numberedList": false
        },
        {
            "id": "deathTime",
            "valueType": "string",
            "makeLink": false,
            "externalLink": false,
            "sortValues": true,
            "numberedList": false
        },
        {
            "id": "municipalityOfDeath",
            "valueType": "object",
            "makeLink": false,
            "externalLink": false,
            "sortValues": true,
            "numberedList": false
        },
        {
            "id": "occupation",
            "valueType": "object",
            "makeLink": false,
            "externalLink": false,
            "sortValues": true,
            "numberedList": false
        },
        {
            "id": "maritalStatus",
            "valueType": "object",
            "makeLink": false,
            "externalLink": false,
            "sortValues": true,
            "numberedList": false
        },
        {
            "id": "motherTongue",
            "valueType": "object",
            "makeLink": false,
            "externalLink": false,
            "sortValues": true,
            "numberedList": false,
            "onlyOnInstancePage": true
        },
        {
            "id": "article",
            "valueType": "object",
            "makeLink": true,
            "externalLink": true,
            "sortValues": true,
            "numberedList": false,
            "onlyOnInstancePage": true,
            "expandedOnInstancePage": true
        },
        {
            "id": "source",
            "valueType": "object",
            "makeLink": false,
            "externalLink": false,
            "sortValues": true,
            "numberedList": false,
            "onlyOnInstancePage": true
        },
        {
            "id": "uri",
            "valueType": "object",
            "makeLink": true,
            "externalLink": true,
            "sortValues": true,
            "numberedList": false,
            "onlyOnInstancePage": true
        }
    ],
    "facets": {
        "prefLabel": {
            "containerClass": "one",
            "facetType": "text",
            "filterType": "textFilter",
            "sortByPredicate": "skos:prefLabel",
            "textQueryProperty": "skos:prefLabel",
            "textQueryType": "regex"
        },
        "rank": {
            "containerClass": "ten",
            "facetType": "list",
            "facetLabelFilter": "FILTER(LANG(?prefLabel_) = '<LANG>')",
            "filterType": "uriFilter",
            "predicate": "prisoners:rank",
            "searchField": true,
            "sortButton": true,
            "sortBy": "instanceCount",
            "sortByPredicate": "prisoners:rank/skos:prefLabel",
            "sortDirection": "desc"
        },
        "occupation": {
            "containerClass": "ten",
            "facetType": "list",
            "facetLabelFilter": "FILTER(LANG(?prefLabel_) = '<LANG>')",
            "filterType": "uriFilter",
            "predicate": "bioc:has_occupation",
            "searchField": true,
            "sortButton": true,
            "sortBy": "instanceCount",
            "sortByPredicate": "bioc:has_occupation/skos:prefLabel",
            "sortDirection": "desc"
        },
        "motherTongue": {
            "containerClass": "ten",
            "facetType": "list",
            "facetLabelFilter": "FILTER(LANG(?prefLabel_) = '<LANG>')",
            "filterType": "uriFilter",
            "predicate": "warsa:mother_tongue",
            "searchField": true,
            "sortButton": true,
            "sortBy": "instanceCount",
            "sortByPredicate": "warsa:mother_tongue/skos:prefLabel",
            "sortDirection": "desc"
        },
        "maritalStatus": {
            "containerClass": "ten",
            "facetType": "list",
            "facetLabelFilter": "FILTER(LANG(?prefLabel_) = '<LANG>')",
            "filterType": "uriFilter",
            "predicate": "prisoners:marital_status",
            "searchField": true,
            "sortButton": true,
            "sortBy": "instanceCount",
            "sortByPredicate": "prisoners:marital_status/skos:prefLabel",
            "sortDirection": "desc"
        },
        "municipalityOfDeath": {
            "containerClass": "ten",
            "facetType": "list",
            "filterType": "uriFilter",
            "predicate": "crm-org:P70_documents/crm-org:P70i_is_documented_in/casualties:municipality_of_death",
            "searchField": true,
            "sortButton": true,
            "sortBy": "instanceCount",
            "sortByPredicate": "crm-org:P70_documents/crm-org:P70i_is_documented_in/casualties:municipality_of_death/skos:prefLabel",
            "sortDirection": "desc"
        },
        "deathTime": {
            "containerClass": "five",
            "facetType": "integer",
            "filterType": "dateNoTimespanFilter",
            "facetValueFilter": "FILTER(datatype(?value) = xsd:date)",
            "predicate": "prisoners:date_of_death",
            "startProperty": "prisoners:date_of_death",
            "endProperty": "prisoners:date_of_death",
            "min": "1750-01-01",
            "max": "2010-01-01",
            "sortByPredicate": "prisoners:date_of_death",
            "sortByAscPredicate": "prisoners:date_of_death",
            "sortByDescPredicate": "prisoners:date_of_death"
        },
        "unit": {
            "containerClass": "ten",
            "facetType": "list",
            "filterType": "uriFilter",
            "predicate": "prisoners:unit",
            "searchField": true,
            "sortButton": true,
            "sortBy": "instanceCount",
            "sortByPredicate": "prisoners:unit/skos:prefLabel",
            "sortDirection": "desc"
        },
        "article": {
            "containerClass": "ten",
            "facetType": "list",
            "filterType": "uriFilter",
            "predicate": "crm-org:P70_documents/^articles:mentionsPerson",
            "labelPattern": "OPTIONAL { ?id dce:title ?title_ ; articles:issue/skos:prefLabel ?issue_ . BIND(CONCAT(STR(?title_), \" (Kansa Taisteli \", STR(?issue_), \")\") AS ?prefLabel_) } BIND(COALESCE(STR(?prefLabel_), STR(?id)) AS ?prefLabel)",
            "searchField": true,
            "sortButton": true,
            "sortBy": "instanceCount",
            "sortByPredicate": "crm-org:P70_documents/^articles:mentionsPerson/dce:title",
            "sortDirection": "desc"
        }
    }
}